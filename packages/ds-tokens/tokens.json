{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Walden Corp Design System — Design Tokens v1.0.1",

  "color": {
    "primitive": {
      "blue": {
        "950": { "$value": "#0F2052", "$type": "color", "$description": "Midnight Blue — Primary" },
        "800": { "$value": "#1E3A8A", "$type": "color", "$description": "Primary Light" },
        "990": { "$value": "#081331", "$type": "color", "$description": "Primary Dark" }
      },
      "silver": {
        "300": { "$value": "#C0C0C0", "$type": "color", "$description": "Silver — Secondary" },
        "200": { "$value": "#E4E4E7", "$type": "color", "$description": "Silver Light" },
        "400": { "$value": "#A1A1AA", "$type": "color", "$description": "Silver Dark" }
      },
      "black": {
        "900": { "$value": "#1C1C1E", "$type": "color", "$description": "Deep Black — Neutral Dark" }
      },
      "white": {
        "0": { "$value": "#FFFFFF", "$type": "color", "$description": "White — Neutral Light" }
      },
      "gray": {
        "50":  { "$value": "#FAFAFA", "$type": "color" },
        "100": { "$value": "#F4F4F5", "$type": "color" },
        "200": { "$value": "#E4E4E7", "$type": "color" },
        "300": { "$value": "#D4D4D8", "$type": "color" },
        "400": { "$value": "#A1A1AA", "$type": "color" },
        "500": { "$value": "#71717A", "$type": "color" },
        "600": { "$value": "#52525B", "$type": "color" },
        "700": { "$value": "#3F3F46", "$type": "color" },
        "800": { "$value": "#27272A", "$type": "color" },
        "900": { "$value": "#18181B", "$type": "color" },
        "950": { "$value": "#0F0F11", "$type": "color" }
      },
      "green": {
        "700": { "$value": "#15803D", "$type": "color" },
        "100": { "$value": "#DCFCE7", "$type": "color" },
        "800": { "$value": "#166534", "$type": "color" }
      },
      "amber": {
        "700": { "$value": "#B45309", "$type": "color" },
        "100": { "$value": "#FEF3C7", "$type": "color" },
        "800": { "$value": "#92400E", "$type": "color" }
      },
      "red": {
        "700": { "$value": "#B91C1C", "$type": "color" },
        "100": { "$value": "#FEE2E2", "$type": "color" },
        "800": { "$value": "#991B1B", "$type": "color" }
      },
      "info": {
        "500": { "$value": "#1D4ED8", "$type": "color" },
        "100": { "$value": "#DBEAFE", "$type": "color" },
        "700": { "$value": "#1E40AF", "$type": "color" }
      }
    },

    "semantic": {
      "text": {
        "primary":    { "$value": "{color.primitive.black.900}", "$type": "color" },
        "secondary":  { "$value": "{color.primitive.gray.500}",  "$type": "color" },
        "tertiary":   { "$value": "{color.primitive.gray.400}",  "$type": "color" },
        "disabled":   { "$value": "{color.primitive.gray.300}",  "$type": "color" },
        "inverse":    { "$value": "{color.primitive.white.0}",   "$type": "color" },
        "link":       { "$value": "{color.primitive.blue.950}",  "$type": "color" },
        "primary-dark":   { "$value": "{color.primitive.gray.50}",  "$type": "color" },
        "secondary-dark": { "$value": "{color.primitive.gray.400}", "$type": "color" },
        "inverse-dark":   { "$value": "{color.primitive.black.900}", "$type": "color" }
      },
      "surface": {
        "base":     { "$value": "{color.primitive.white.0}",  "$type": "color" },
        "raised":   { "$value": "{color.primitive.white.0}",  "$type": "color" },
        "sunken":   { "$value": "{color.primitive.gray.50}",  "$type": "color" },
        "overlay":  { "$value": "{color.primitive.white.0}",  "$type": "color" },
        "disabled": { "$value": "{color.primitive.gray.100}", "$type": "color" },
        "inverse":  { "$value": "{color.primitive.black.900}", "$type": "color" },
        "base-dark":     { "$value": "{color.primitive.gray.950}", "$type": "color" },
        "raised-dark":   { "$value": "{color.primitive.gray.900}", "$type": "color" },
        "overlay-dark":  { "$value": "{color.primitive.gray.800}", "$type": "color" }
      },
      "border": {
        "subtle":  { "$value": "{color.primitive.gray.200}", "$type": "color" },
        "default": { "$value": "{color.primitive.gray.300}", "$type": "color" },
        "strong":  { "$value": "{color.primitive.gray.400}", "$type": "color" },
        "focus":   { "$value": "{color.primitive.blue.950}", "$type": "color" },
        "error":   { "$value": "{color.primitive.red.700}",  "$type": "color" },
        "subtle-dark":  { "$value": "{color.primitive.gray.800}", "$type": "color" },
        "default-dark": { "$value": "{color.primitive.gray.700}", "$type": "color" }
      },
      "action": {
        "primary":        { "$value": "{color.primitive.blue.950}", "$type": "color" },
        "primary-hover":  { "$value": "{color.primitive.blue.800}", "$type": "color" },
        "primary-active": { "$value": "{color.primitive.blue.990}", "$type": "color" },
        "primary-disabled": { "$value": "{color.primitive.gray.300}", "$type": "color" },
        "secondary":      { "$value": "{color.primitive.white.0}",  "$type": "color" },
        "destructive":    { "$value": "{color.primitive.red.700}",  "$type": "color" },
        "primary-dark":   { "$value": "{color.primitive.silver.300}", "$type": "color" }
      },
      "state": {
        "success":         { "$value": "{color.primitive.green.700}", "$type": "color" },
        "success-subtle":  { "$value": "{color.primitive.green.100}", "$type": "color" },
        "warning":         { "$value": "{color.primitive.amber.700}", "$type": "color" },
        "warning-subtle":  { "$value": "{color.primitive.amber.100}", "$type": "color" },
        "error":           { "$value": "{color.primitive.red.700}",   "$type": "color" },
        "error-subtle":    { "$value": "{color.primitive.red.100}",   "$type": "color" },
        "info":            { "$value": "{color.primitive.info.500}",  "$type": "color" },
        "info-subtle":     { "$value": "{color.primitive.info.100}",  "$type": "color" }
      }
    }
  },

  "typography": {
    "family": {
      "base":  { "$value": "Inter, 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$type": "fontFamily" },
      "mono":  { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "scale": {
      "display-xl": { "$value": { "fontSize": "48px", "lineHeight": "1.2", "fontWeight": 600, "letterSpacing": "-0.02em" }, "$type": "typography" },
      "display-lg": { "$value": { "fontSize": "40px", "lineHeight": "1.25", "fontWeight": 600, "letterSpacing": "-0.02em" }, "$type": "typography" },
      "heading-1":  { "$value": { "fontSize": "32px", "lineHeight": "1.3", "fontWeight": 600, "letterSpacing": "-0.01em" }, "$type": "typography" },
      "heading-2":  { "$value": { "fontSize": "24px", "lineHeight": "1.35", "fontWeight": 600, "letterSpacing": "-0.01em" }, "$type": "typography" },
      "heading-3":  { "$value": { "fontSize": "20px", "lineHeight": "1.4", "fontWeight": 600, "letterSpacing": "-0.005em" }, "$type": "typography" },
      "heading-4":  { "$value": { "fontSize": "18px", "lineHeight": "1.45", "fontWeight": 600, "letterSpacing": "0" }, "$type": "typography" },
      "body-lg":    { "$value": { "fontSize": "18px", "lineHeight": "1.55", "fontWeight": 400, "letterSpacing": "0" }, "$type": "typography" },
      "body-md":    { "$value": { "fontSize": "16px", "lineHeight": "1.55", "fontWeight": 400, "letterSpacing": "0" }, "$type": "typography" },
      "body-sm":    { "$value": { "fontSize": "14px", "lineHeight": "1.5", "fontWeight": 400, "letterSpacing": "0" }, "$type": "typography" },
      "label":      { "$value": { "fontSize": "14px", "lineHeight": "1.4", "fontWeight": 500, "letterSpacing": "0" }, "$type": "typography" },
      "caption":    { "$value": { "fontSize": "13px", "lineHeight": "1.4", "fontWeight": 400, "letterSpacing": "0" }, "$type": "typography" },
      "micro":      { "$value": { "fontSize": "12px", "lineHeight": "1.4", "fontWeight": 500, "letterSpacing": "0.02em" }, "$type": "typography" },
      "code":       { "$value": { "fontSize": "14px", "lineHeight": "1.5", "fontWeight": 400, "letterSpacing": "0" }, "$type": "typography" }
    }
  },

  "spacing": {
    "0":  { "$value": "0",     "$type": "dimension" },
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "20": { "$value": "80px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "xs":   { "$value": "2px",   "$type": "dimension" },
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "xl":   { "$value": "16px",  "$type": "dimension" },
    "2xl":  { "$value": "24px",  "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "elevation": {
    "0": { "$value": "none", "$type": "shadow" },
    "1": { "$value": "0 1px 2px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.10)", "$type": "shadow" },
    "2": { "$value": "0 2px 4px rgba(0,0,0,0.06), 0 4px 8px rgba(0,0,0,0.08)", "$type": "shadow" },
    "3": { "$value": "0 4px 8px rgba(0,0,0,0.08), 0 8px 16px rgba(0,0,0,0.10)", "$type": "shadow" },
    "4": { "$value": "0 8px 16px rgba(0,0,0,0.10), 0 16px 32px rgba(0,0,0,0.12)", "$type": "shadow" }
  },

  "zIndex": {
    "base":     { "$value": 0,    "$type": "number" },
    "sticky":   { "$value": 100,  "$type": "number" },
    "dropdown": { "$value": 200,  "$type": "number" },
    "overlay":  { "$value": 300,  "$type": "number" },
    "modal":    { "$value": 400,  "$type": "number" },
    "toast":    { "$value": 500,  "$type": "number" },
    "tooltip":  { "$value": 600,  "$type": "number" },
    "debug":    { "$value": 9999, "$type": "number" }
  },

  "opacity": {
    "0":   { "$value": 0.00, "$type": "number" },
    "5":   { "$value": 0.05, "$type": "number" },
    "10":  { "$value": 0.10, "$type": "number" },
    "20":  { "$value": 0.20, "$type": "number" },
    "30":  { "$value": 0.30, "$type": "number" },
    "40":  { "$value": 0.40, "$type": "number" },
    "50":  { "$value": 0.50, "$type": "number" },
    "60":  { "$value": 0.60, "$type": "number" },
    "80":  { "$value": 0.80, "$type": "number" },
    "100": { "$value": 1.00, "$type": "number" }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration" },
      "fast":    { "$value": "100ms", "$type": "duration" },
      "base":    { "$value": "150ms", "$type": "duration" },
      "medium":  { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "300ms", "$type": "duration" },
      "long":    { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
      "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" },
      "linear":   { "$value": "linear", "$type": "cubicBezier" }
    }
  },

  "breakpoint": {
    "xs":  { "$value": "0px",    "$type": "dimension" },
    "sm":  { "$value": "480px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1440px", "$type": "dimension" },
    "2xl": { "$value": "1920px", "$type": "dimension" }
  },

  "icon": {
    "size": {
      "xs":  { "$value": "12px", "$type": "dimension" },
      "sm":  { "$value": "16px", "$type": "dimension" },
      "md":  { "$value": "20px", "$type": "dimension" },
      "lg":  { "$value": "24px", "$type": "dimension" },
      "xl":  { "$value": "32px", "$type": "dimension" },
      "2xl": { "$value": "48px", "$type": "dimension" },
      "3xl": { "$value": "64px", "$type": "dimension" }
    }
  }
}
