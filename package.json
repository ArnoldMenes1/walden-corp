{
  "name": "walden-corp",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Walden Corp — Constitution Repository",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ai:index": "tsx scripts/generate-ai-index.ts",
    "docs:validate": "tsx scripts/validate-docs.ts",
    "docs:validate:strict": "tsx scripts/validate-docs.ts --strict",
    "docs:pdf": "tsx scripts/export-pdf.ts",
    "search:build": "tsx scripts/build-search-index.ts",
    "docs:sync": "tsx scripts/sync-docs.ts",
    "docs:sync:dry": "tsx scripts/sync-docs.ts --dry-run",
    "docs:sync:clean": "tsx scripts/sync-docs.ts --clean",
    "lint": "eslint scripts src packages apps --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "chalk": "^5.3.0",
    "eslint": "^8.57.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
